# 隔离测试 Neon 分支；复制为 .env.test.local。禁止填正式库。
TEST_DATABASE_URL=
ALSVID_TEST_MODE=1
ALSVID_PREVIEW_SECRET=
ALSVID_REVALIDATE_TOKEN=
# 生产入口单独配置，以下仅为变量名。
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DIRECT_DATABASE_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
ALSVID_STOREFRONT_ORIGIN=
ALSVID_STOREFRONT_PUBLIC_ORIGIN=
ALSVID_SECRET_JSON=

# 默认关闭消费者注册；配置实际已验证发信域名及服务端随机密钥后才启用。
ALSVID_CONSUMER_REGISTRATION=0
RESEND_API_KEY=
ALSVID_MAIL_FROM=
ALSVID_REGISTRATION_SECRET=
