# 8089 业务 API 源（8091 只通过它访问业务数据，不直连数据库）
ALSVID_API_ORIGIN=http://127.0.0.1:8089

# 本站可信来源（逗号分隔）。用于 /api 代理的 Origin/Referer 校验，
# 生产环境必须写成真实域名，例如 https://www.alsvidbike.com
SITE_ORIGINS=http://localhost:8091,http://127.0.0.1:8091

# 对外站点地址（canonical / sitemap / hreflang 使用）
SITE_URL=http://localhost:8091

# 默认语言与支持语言
DEFAULT_LOCALE=de
SUPPORTED_LOCALES=de,en,zh

# 缓存刷新与草稿预览令牌（部署时单独配置，禁止提交真实值）
REVALIDATE_SECRET=
PREVIEW_SECRET=
