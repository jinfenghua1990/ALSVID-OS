FROM node:22-alpine AS web
WORKDIR /app/apps/admin-web
COPY apps/admin-web/package.json apps/admin-web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/admin-web/ ./
RUN npm run build
FROM node:22-alpine
WORKDIR /app/apps/admin-api
COPY apps/admin-api/package.json apps/admin-api/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --chown=node:node apps/admin-api/ ./
COPY --from=web --chown=node:node /app/apps/admin-web/dist /app/apps/admin-web/dist
ENV PORT=8089 ALSVID_BIND_HOST=0.0.0.0
USER node
EXPOSE 8089
CMD ["node","index.js"]
