FROM node:22-alpine AS build
WORKDIR /app
COPY apps/storefront/package.json apps/storefront/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/storefront/ ./
ENV NEXT_TELEMETRY_DISABLED=1 ALSVID_API_ORIGIN=http://127.0.0.1:8089 SITE_ORIGINS=http://127.0.0.1:8091 SITE_URL=http://127.0.0.1:8091
RUN npm run build
FROM node:22-alpine
WORKDIR /app
COPY --from=build --chown=node:node /app /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
USER node
EXPOSE 8091
CMD ["node","node_modules/next/dist/bin/next","start","-H","0.0.0.0","-p","8091"]
